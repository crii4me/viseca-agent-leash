# Copy to .env and fill in. .env is gitignored - never commit a real key.

# --- Function 1 (mandate compiler) ---------------------------------------
# auto          use the model when a key is present, deterministic otherwise
# deterministic force the offline regex backend (no key, no network)
# anthropic     force the model backend (fails loudly if the key is missing)
MANDATE_BACKEND=auto

# Only used by the anthropic backend.
ANTHROPIC_API_KEY=

# Latency sub-problem: this runs once per mandate, so opus is affordable here.
# Try claude-haiku-4-5 if you want to measure the fast path.
MANDATE_MODEL=claude-opus-5
MANDATE_MAX_TOKENS=8000

# How to route a clause that shapes judgment but has no resolvable threshold
# (the "a shop I use regularly" case): guidance | open_question | both
MANDATE_UNRESOLVABLE_TO=both

# Keep at 1. Set to 0 only when debugging, to make an uncompilable rule raise
# instead of being demoted to guidance.
MANDATE_DEMOTE_UNKNOWN_FIELDS=1

# --- Function 2 (decision engine) - NOT used by Function 1 ----------------
# Here so the team has one place for config. The mandate compiler never reads
# these; it makes no Viseca API calls.
# LEASH_BASE_URL=
# LEASH_API_KEY=
